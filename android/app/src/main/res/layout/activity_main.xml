<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/stageImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/stage_description"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <WebView
        android:id="@+id/stageBoard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/stageVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pairingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pairing_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="@string/brand"
            android:textAllCaps="true"
            android:textColor="#8FD3FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/pairing_title"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/codeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:text="------"
            android:textColor="@color/ink"
            android:textSize="72sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/pairing_help"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#D5E6FF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/newCodeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_tv"
                android:focusable="true"
                android:minHeight="52dp"
                android:minWidth="180dp"
                android:text="@string/new_code"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <Button
                android:id="@+id/serverButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_tv"
                android:focusable="true"
                android:minHeight="52dp"
                android:minWidth="160dp"
                android:text="@string/server"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/waitingText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pairing_bg"
        android:gravity="center"
        android:padding="48dp"
        android:text="@string/waiting"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:visibility="gone" />
</FrameLayout>
