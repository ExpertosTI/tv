---
import Base from '../layouts/Base.astro';
const title = 'Página no encontrada · RENACE Pantalla';
const description = 'Esa dirección no existe en RENACE Pantalla.';
---
<Base title={title} description={description}>
  <main id="contenido" class="mx-auto max-w-[680px] px-4 pb-20 pt-40">
    <p class="text-sm font-semibold text-[#0087FF]">404</p>
    <h1 class="mt-3 text-5xl font-semibold text-balance">Esta página no está en la lista.</h1>
    <p class="mt-4 text-pretty text-[#9B9B9B]">La dirección no coincide con ninguna sección. Vuelve al inicio o crea el menú en el panel.</p>
    <p class="mt-6"><a class="inline-flex rounded-lg bg-[#0060BF] px-3 py-2 text-base font-semibold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0087FF]" href="/">Volver al inicio</a></p>
  </main>
</Base>
