---
import Base from '../layouts/Base.astro';
const title = 'Términos · RENACE Pantalla';
const description = 'Condiciones de uso de RENACE Pantalla para el menú en la televisión.';
---
<Base title={title} description={description}>
  <main id="contenido" class="mx-auto max-w-[680px] px-4 pb-20 pt-40">
    <h1 class="text-5xl font-semibold text-balance">Términos</h1>
    <p class="mt-6 text-pretty text-[#9B9B9B]">RENACE Pantalla muestra en la televisión el contenido que el negocio publica. El negocio responde por los precios, las fotos y los videos que sube, y por tener derecho a usarlos.</p>
    <p class="mt-4 text-pretty text-[#9B9B9B]">El servicio se opera en el servidor del propio negocio. Cerrar el registro evita cuentas nuevas. Desvincular una TV deja de mostrar esa lista.</p>
    <p class="mt-10"><a class="font-semibold text-[#8FD3FF] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0087FF]" href="/">Volver al inicio</a></p>
  </main>
</Base>
